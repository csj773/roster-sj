rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.owner == request.auth.uid;
    }

    function createsOwnDoc() {
      return signedIn() && request.resource.data.owner == request.auth.uid;
    }

    function keepsOwner() {
      return signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner;
    }

    function userEmailMatchesExisting() {
      return signedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email;
    }

    function userEmailMatchesNew() {
      return signedIn()
        && request.auth.token.email != null
        && request.resource.data.email == request.auth.token.email;
    }

    match /roster/{docId} {
      allow read, delete: if isOwner();
      allow create: if createsOwnDoc();
      allow update: if keepsOwner();
    }

    match /rosterByUser/{docId} {
      allow read, delete: if isOwner();
      allow create: if createsOwnDoc();
      allow update: if keepsOwner();

      match /events/{eventId} {
        allow read, delete: if signedIn()
          && (docId == request.auth.uid || resource.data.owner == request.auth.uid);
        allow create: if signedIn()
          && docId == request.auth.uid
          && request.resource.data.owner == request.auth.uid;
        allow update: if signedIn()
          && docId == request.auth.uid
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner;
      }
    }

    match /Perdiem/{docId} {
      allow read, delete: if isOwner();
      allow create: if createsOwnDoc();
      allow update: if keepsOwner();

      match /events/{eventId} {
        allow read, delete: if signedIn()
          && (docId == request.auth.uid || resource.data.owner == request.auth.uid);
        allow create: if signedIn()
          && docId == request.auth.uid
          && request.resource.data.owner == request.auth.uid;
        allow update: if signedIn()
          && docId == request.auth.uid
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner;
      }
    }

    match /PerdiemEvents/{docId} {
      allow read, delete: if isOwner();
      allow create: if createsOwnDoc();
      allow update: if keepsOwner();
    }

    match /Payments/{docId} {
      allow read, delete: if isOwner();
      allow create: if createsOwnDoc();
      allow update: if keepsOwner();
    }

    match /PaymentsByUser/{docId} {
      allow read, delete: if isOwner();
      allow create: if createsOwnDoc();
      allow update: if keepsOwner();

      match /events/{eventId} {
        allow read, delete: if signedIn()
          && (docId == request.auth.uid || resource.data.owner == request.auth.uid);
        allow create: if signedIn()
          && docId == request.auth.uid
          && request.resource.data.owner == request.auth.uid;
        allow update: if signedIn()
          && docId == request.auth.uid
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner;
      }
    }

    match /pdc/{docId} {
      allow read, delete: if isOwner();
      allow create: if createsOwnDoc();
      allow update: if keepsOwner();

      match /events/{eventId} {
        allow read, delete: if signedIn()
          && (docId == request.auth.uid || resource.data.owner == request.auth.uid);
        allow create: if signedIn()
          && docId == request.auth.uid
          && request.resource.data.owner == request.auth.uid;
        allow update: if signedIn()
          && docId == request.auth.uid
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner;
      }
    }

    match /PdcEvents/{docId} {
      allow read, delete: if isOwner();
      allow create: if createsOwnDoc();
      allow update: if keepsOwner();
    }

    match /{path=**}/events/{eventId} {
      allow read: if signedIn() && resource.data.owner == request.auth.uid;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /roster_share_invites/{inviteId} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.acceptedByUid == request.auth.uid);
      allow write: if false;
    }

    match /roster_shares/{shareId} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.sharedWithUid == request.auth.uid);
      allow write: if false;
    }

    match /roster_friendships/{friendshipId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.users;
      allow write: if false;
    }

    match /slack_user_links/{linkId} {
      allow read, write: if false;
    }

    match /Pilotlog/{docId} {
      allow read, delete: if isOwner() || userEmailMatchesExisting();
      allow create: if createsOwnDoc() || userEmailMatchesNew();
      allow update: if keepsOwner()
        || (userEmailMatchesExisting()
          && userEmailMatchesNew()
          && request.resource.data.email == resource.data.email);
    }

    match /PilotlogByUser/{docId} {
      allow read, delete: if isOwner();
      allow create: if createsOwnDoc();
      allow update: if keepsOwner();

      match /events/{eventId} {
        allow read, delete: if signedIn()
          && (docId == request.auth.uid || resource.data.owner == request.auth.uid);
        allow create: if signedIn()
          && docId == request.auth.uid
          && request.resource.data.owner == request.auth.uid;
        allow update: if signedIn()
          && docId == request.auth.uid
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner;
      }
    }

    match /salaryReportRuns/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
